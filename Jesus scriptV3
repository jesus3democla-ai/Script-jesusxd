-- Script Jesús v3 (Con Menú Circular, Dash, TP con Distancia, X-Ray y Anti-AFK)
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local VirtualUser = game:GetService("VirtualUser")

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Parent = game.CoreGui
ScreenGui.Name = "JesusPanelV3"

-- 1. BOTÓN CIRCULAR (+ / -)
local CircleBtn = Instance.new("TextButton")
CircleBtn.Parent = ScreenGui
CircleBtn.Position = UDim2.new(0.05, 0, 0.25, 0)
CircleBtn.Size = UDim2.new(0, 45, 0, 45)
CircleBtn.Text = "-"
CircleBtn.TextSize = 24
CircleBtn.Font = Enum.Font.SourceSansBold
CircleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
CircleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
CircleBtn.Active = true
CircleBtn.Draggable = true

local UICornerBtn = Instance.new("UICorner")
UICornerBtn.CornerRadius = UDim.new(1, 0)
UICornerBtn.Parent = CircleBtn

-- 2. MINI PANEL PRINCIPAL
local Frame = Instance.new("Frame")
Frame.Parent = ScreenGui
Frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
Frame.Position = UDim2.new(0.2, 0, 0.15, 0)
Frame.Size = UDim2.new(0, 230, 0, 310)
Frame.Active = true
Frame.Draggable = true

local FrameCorner = Instance.new("UICorner")
FrameCorner.CornerRadius = UDim.new(0, 10)
FrameCorner.Parent = Frame

local Title = Instance.new("TextLabel")
Title.Parent = Frame
Title.Size = UDim2.new(1, 0, 0, 35)
Title.Text = "Script Jesús v3"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
Title.Font = Enum.Font.SourceSansBold
Title.TextSize = 18

local TitleCorner = Instance.new("UICorner")
TitleCorner.CornerRadius = UDim.new(0, 10)
TitleCorner.Parent = Title

CircleBtn.MouseButton1Click:Connect(function()
    Frame.Visible = not Frame.Visible
    CircleBtn.Text = Frame.Visible and "-" or "+"
end)

-- 3. FUNCIONES DEL PANEL

-- A) Velocidad
local SpeedBtn = Instance.new("TextButton")
SpeedBtn.Parent = Frame
SpeedBtn.Position = UDim2.new(0.08, 0, 0.14, 0)
SpeedBtn.Size = UDim2.new(0.84, 0, 0, 32)
SpeedBtn.Text = "Velocidad: OFF"
SpeedBtn.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
SpeedBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

local speedOn = false
SpeedBtn.MouseButton1Click:Connect(function()
    speedOn = not speedOn
    SpeedBtn.Text = speedOn and "Velocidad: ON" or "Velocidad: OFF"
    SpeedBtn.BackgroundColor3 = speedOn and Color3.fromRGB(40, 150, 40) or Color3.fromRGB(150, 40, 40)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = speedOn and 60 or 16
    end
end)

-- B) X-Ray
local XRayBtn = Instance.new("TextButton")
XRayBtn.Parent = Frame
XRayBtn.Position = UDim2.new(0.08, 0, 0.27, 0)
XRayBtn.Size = UDim2.new(0.84, 0, 0, 32)
XRayBtn.Text = "X-Ray: OFF"
XRayBtn.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
XRayBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

local xrayOn = false
XRayBtn.MouseButton1Click:Connect(function()
    xrayOn = not xrayOn
    XRayBtn.Text = xrayOn and "X-Ray: ON" or "X-Ray: OFF"
    XRayBtn.BackgroundColor3 = xrayOn and Color3.fromRGB(40, 150, 40) or Color3.fromRGB(150, 40, 40)
    for _, object in pairs(Workspace:GetDescendants()) do
        if object:IsA("BasePart") and not object:IsDescendantOf(LocalPlayer.Character) then
            object.LocalTransparencyModifier = xrayOn and 0.5 or 0
        end
    end
end)

-- C) Dash (Impulso Rápido)
local DashBtn = Instance.new("TextButton")
DashBtn.Parent = Frame
DashBtn.Position = UDim2.new(0.08, 0, 0.40, 0)
DashBtn.Size = UDim2.new(0.84, 0, 0, 32)
DashBtn.Text = "⚡ Usar Dash"
DashBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
DashBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

DashBtn.MouseButton1Click:Connect(function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        hrp.CFrame = hrp.CFrame + (hrp.CFrame.LookVector * 25)
    end
end)

-- D) Teleport con Distancia
local tpDistance = 30

local DistLabel = Instance.new("TextLabel")
DistLabel.Parent = Frame
DistLabel.Position = UDim2.new(0.08, 0, 0.53, 0)
DistLabel.Size = UDim2.new(0.84, 0, 0, 25)
DistLabel.Text = "Distancia TP: " .. tpDistance
DistLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
DistLabel.BackgroundTransparency = 1

local MinusBtn = Instance.new("TextButton")
MinusBtn.Parent = Frame
MinusBtn.Position = UDim2.new(0.08, 0, 0.63, 0)
MinusBtn.Size = UDim2.new(0.38, 0, 0, 30)
MinusBtn.Text = "- 10"
MinusBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
MinusBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

local PlusBtn = Instance.new("TextButton")
PlusBtn.Parent = Frame
PlusBtn.Position = UDim2.new(0.54, 0, 0.63, 0)
PlusBtn.Size = UDim2.new(0.38, 0, 0, 30)
PlusBtn.Text = "+ 10"
PlusBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
PlusBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

MinusBtn.MouseButton1Click:Connect(function()
    if tpDistance > 10 then
        tpDistance = tpDistance - 10
        DistLabel.Text = "Distancia TP: " .. tpDistance
    end
end)

PlusBtn.MouseButton1Click:Connect(function()
    tpDistance = tpDistance + 10
    DistLabel.Text = "Distancia TP: " .. tpDistance
end)

local TPBtn = Instance.new("TextButton")
TPBtn.Parent = Frame
TPBtn.Position = UDim2.new(0.08, 0, 0.76, 0)
TPBtn.Size = UDim2.new(0.84, 0, 0, 35)
TPBtn.Text = "🚀 Teleport Adelante"
TPBtn.BackgroundColor3 = Color3.fromRGB(120, 40, 180)
TPBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

TPBtn.MouseButton1Click:Connect(function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        hrp.CFrame = hrp.CFrame + (hrp.CFrame.LookVector * tpDistance)
    end
end)

-- E) Anti-AFK Automático
LocalPlayer.Idled:Connect(function()
    VirtualUser:Button2Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
    wait(1)
    VirtualUser:Button2Up(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
end)
